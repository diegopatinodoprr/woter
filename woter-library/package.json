{
  "name": "@diegopatinodoprr/woter-library",
  "version": "0.1.11",
  "description": "Shared interfaces and services for Woter platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json -w",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist",
    "lint": "tsc -p tsconfig.json --noEmit",
    "schemas:export": "node --env-file=.env scripts/export-woter-schemas.js",
    "schemas:push": "node --env-file=.env scripts/push-woter-schemas.js",
    "schemas:generate": "node scripts/generate-interfaces-from-schemas.js",
    "schemas:generate:seed": "SCHEMAS_INPUT_PATH=schemas/woterSchemas.seed.json node scripts/generate-interfaces-from-schemas.js",
    "schemas:sync": "npm run schemas:export && npm run schemas:generate",
    "schemas:apply": "npm run schemas:generate:seed && npm run schemas:push && npm run schemas:export && npm run schemas:generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diegopatinodoprr/woter.git",
    "directory": "woter-library"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "mongodb": "^7.1.0",
    "prettier-eslint": "^16.4.2",
    "typescript": "^5.6.3"
  }
}
