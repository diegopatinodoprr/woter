<section class="schema-module">
  <app-<%= kebabName %>-listview
    *ngIf="isListMode()"
    [title]="'<%= schemaName %> List'"
    [items]="items"
    [isLoading]="isLoading"
    [getItemName]="getItemName.bind(this)"
    [getItemId]="getItemId.bind(this)"
    (createNew)="openNew()"
    (editItem)="openEdit($event)"
  ></app-<%= kebabName %>-listview>

  <app-<%= kebabName %>-formedit
    *ngIf="isEditMode()"
    [title]="'<%= schemaName %> Edit'"
    [form]="form"
    [fields]="fields"
    [errorMessage]="errorMessage"
    [successMessage]="successMessage"
    [isSaving]="isSaving"
    (back)="goToList()"
    (save)="save()"
  ></app-<%= kebabName %>-formedit>

  <app-<%= kebabName %>-formnew
    *ngIf="isNewMode()"
    [title]="'<%= schemaName %> Create'"
    [form]="form"
    [fields]="fields"
    [errorMessage]="errorMessage"
    [successMessage]="successMessage"
    [isSaving]="isSaving"
    (back)="goToList()"
    (save)="save()"
  ></app-<%= kebabName %>-formnew>
</section>
